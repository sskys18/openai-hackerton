{
  "name": "culprit",
  "version": "0.1.0",
  "description": "A Codex plugin (MCP server) that turns a failing test or bug report into a root-caused fix: it reproduces the failure, drives git bisect to find the offending commit, explains the root cause with GPT-5.6, and proposes a fix PR.",
  "type": "module",
  "bin": {
    "culprit": "./src/server.ts"
  },
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch run src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "codex",
    "mcp",
    "git-bisect",
    "regression",
    "developer-tools",
    "openai"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "openai": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  }
}
