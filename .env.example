# Culprit configuration
# Copy to .env and fill in. Only OPENAI_API_KEY is required.

# OpenAI API key used for the GPT-5.6 root-cause analysis step.
OPENAI_API_KEY=sk-...

# Model used for root-cause analysis and fix proposals.
CULPRIT_MODEL=gpt-5.6

# Hard cap on bisect steps (safety valve so a bad predicate can't loop forever).
CULPRIT_MAX_BISECT_STEPS=25

# Per-command timeout in seconds for reproduce/predicate runs.
CULPRIT_CMD_TIMEOUT=300
